// Local mixed-input selector. Gestures, previews and cached names stay on device.
#heapsize: 1104
int down;
int preparation;
int preparationPhase;
int epoch;
int revision;
int seen;
int sequence;
int resync;
int resyncAt;
int groupSeen;
int assignmentSeen;
int sourceSeen;
int routeSeen;
int announced;
int named;
int nameAt;
int flashMask;
int flashGroup;
int flashAt;

int dim(int c, float amount) { return blendARGB(0xff000000, (int(amount * 255.0) << 24) | (c & 0xffffff)); }
int countBits(int bits) { int n = 0; while (bits != 0) { bits = bits & (bits - 1); ++n; } return n; }
int desired(int g) { return getHeapInt(32 + g * 4); }
int route(int g) { return getHeapInt(96 + g * 4); }
int tile(int f) { return getHeapByte(260 + f); }
int rgb(int word) { return makeARGB(255, (word & 127) * 2, ((word >> 7) & 127) * 2, ((word >> 14) & 127) * 2); }
bool sourceAvailable(int s, int g)
{
    int facts = getHeapInt(160 + s * 4);
    return (facts & 2097152) != 0 && ((facts & 71303168) != 71303168 || ((facts >> 23) & 7) == g);
}
bool held(int which)
{
    for (int f = 0; f < 16; ++f) if ((down & (1 << f)) != 0 && tile(f) == which) return true;
    return false;
}
int heldGroup()
{
    int group = 127;
    for (int f = 0; f < 16; ++f)
        if ((down & (1 << f)) != 0 && tile(f) < 8)
        { if (group != 127 && group != tile(f)) return 126; group = tile(f); }
    return group;
}
int tileAt(int x, int y)
{
    if (y < 4) return x % 4 < 3 ? (y / 2) * 4 + x / 4 : 127;
    if (y < 5) return 127;
    return 8 + (y - 5) / 2 * 5 + x / 3;
}
bool pending(int g)
{ return getHeapByte(144 + g * 2) != 0 || getHeapByte(145 + g * 2) != 0 || (route(g) & 33554431) != desired(g) || (route(g) & 33554432) != 0; }
void flash(int g, int mask)
{ flashGroup = g; flashMask = mask; flashAt = getMillisecondCounter(); }
int sendIntent(int key, int value)
{
    sequence = (sequence + 1) & 127;
    sendCC(0, 69, epoch); sendCC(0, 70, sequence); sendCC(0, 71, key);
    sendCC(0, 72, value & 127); sendCC(0, 73, value >> 7); sendCC(0, 74, sequence);
    return sequence;
}
void sendBank(int g, int bank)
{
    int key = 48 + g;
    if (bank != 0) key = 116 + g;
    int offset = g * 2 + bank;
    setHeapByte(128 + offset, sendIntent(key, (desired(g) >> (bank * 13)) & (bank == 0 ? 8191 : 4095)));
    setHeapByte(144 + offset, 1);
}
void toggle(int g, int mask)
{
    int allowed = desired(g);
    for (int s = 0; s < 25; ++s) if (sourceAvailable(s, g)) allowed = allowed | (1 << s);
    if ((mask & ~allowed) != 0) flash(g, mask & ~allowed);
    mask = mask & allowed;
    if (mask != 0)
    {
        setHeapInt(32 + g * 4, desired(g) ^ mask);
        if ((mask & 8191) != 0) sendBank(g, 0);
        if ((mask >> 13) != 0) sendBank(g, 1);
    }
}
void ready()
{
    if (!announced && groupSeen == 255 && assignmentSeen == 255 && routeSeen == 255 && sourceSeen == 33554431)
    { announced = 1; sendCC(15, 108, 37); sendCC(15, 106, countBits(down)); sendCC(15, 107, 0); }
}
void initialise()
{
    preparation = 0; preparationPhase = 0;
    for (int i = 0; i < 1104; ++i) setHeapByte(i, 0);
    for (int f = 0; f < 16; ++f) setHeapByte(260 + f, 127);
    named = -1; flashGroup = -1; flashAt = -1000;
    sendCC(15, 110, 19);
}
void touchEvent(int kind, int f, float x, float y)
{
    if (preparationPhase > 0 || f < 0 || f >= 16) return;
    int bit = 1 << f;
    if (kind == 1)
    {
        setHeapByte(260 + f, 127);
        down = down | bit;
        if (announced)
        {
            int t = tileAt(int(clamp(0.0, 14.0, x * 7.5)), int(clamp(0.0, 14.0, y * 7.5)));
            if (t < 8 && (getHeapInt(t * 4) & 2097152) == 0) t = 127;
            setHeapByte(260 + f, t);
            int group = heldGroup();
            if (t >= 8 && t < 33) { named = t - 8; nameAt = getMillisecondCounter(); }
            if (group < 8)
            {
                if (t >= 8 && t < 33) toggle(group, 1 << (t - 8));
                else if (t < 8)
                {
                    int inputs = 0;
                    for (int s = 0; s < 25; ++s) if (held(8 + s)) inputs = inputs | (1 << s);
                    toggle(group, inputs);
                }
            }
        }
    }
    else if (kind == 3 && (down & bit) != 0)
    { down = down & ~bit; setHeapByte(260 + f, 127); nameAt = getMillisecondCounter(); }
    else return;
    sendCC(15, 106, countBits(down));
}
void touchStart(int i, float x, float y, float z, float vz) { touchEvent(1, i, x, y); }
void touchMove(int i, float x, float y, float z, float vz) {}
void touchEnd(int i, float x, float y, float z, float vz) { touchEvent(3, i, x, y); }
void handleMessage(int a, int b, int header)
{
    if ((header & 255) != 242 || header < 0 || ((a | b) & 0xf0000000) != 0) return;
    int kind = (header >> 8) & 7, gen = (header >> 11) & 127, rev = (header >> 18) & 8191;
    if (gen == 0 || (kind != 0 && gen != epoch)) return;
    int distance = (rev - revision) & 8191;
    if (gen == epoch && seen && (distance == 0 || distance >= 4096)) return;
    if (kind != 0 && distance > 1) resync = 1;
    revision = rev; seen = 1;
    if (kind == 0)
    {
        for (int s = 0; s < 25; ++s) setHeapByte(1076 + s, 0);
        if (gen != epoch) { preparation = 0; preparationPhase = 0; sequence = a & 127; }
        epoch = gen; resync = 0;
        for (int g = 0; g < 8; ++g)
            for (int bank = 0; bank < 2; ++bank)
                if (getHeapByte(144 + g * 2 + bank) != 0) sendBank(g, bank);
        if (announced) { sendCC(15, 108, 37); sendCC(15, 106, countBits(down)); sendCC(15, 107, 0); }
        return;
    }
    if (kind == 1 && a >= 80 && a < 88 && b < 33554432)
    {
        int g = a - 80;
        setHeapInt(64 + g * 4, b);
        for (int bank = 0; bank < 2; ++bank)
            if (getHeapByte(144 + g * 2 + bank) == 0)
            {
                int mask = (bank == 0 ? 8191 : 4095) << (bank * 13);
                setHeapInt(32 + g * 4, (desired(g) & ~mask) | (b & mask));
            }
        assignmentSeen = assignmentSeen | (1 << g);
    }
    if (kind == 7) { kind = 2; b = 16383; }
    if (kind == 2)
    {
        int key = a & 127, g = key - 48, bank = 0;
        if (key >= 116 && key < 124) { g = key - 116; bank = 1; }
        int offset = g * 2 + bank;
        if (g >= 0 && g < 8 && getHeapByte(144 + offset) != 0 && (a >> 7) == getHeapByte(128 + offset))
        {
            setHeapByte(144 + offset, 0);
            int limit = bank == 0 ? 8191 : 4095, mask = limit << (bank * 13);
            int actual = getHeapInt(64 + g * 4);
            if (b <= limit) actual = (actual & ~mask) | (b << (bank * 13));
            else flash(g, (desired(g) ^ actual) & mask);
            setHeapInt(64 + g * 4, actual);
            setHeapInt(32 + g * 4, (desired(g) & ~mask) | (actual & mask));
        }
    }
    if (kind == 3 && a < 8 && b < 16777216)
    { setHeapInt(a * 4, b); groupSeen = groupSeen | (1 << a); }
    if (kind == 6)
    {
        if (a == 3 && b < 16383 && b != preparation) { preparation = b; preparationPhase = 0; }
        if (a >= 8 && a < 16 && b < 134217728)
        {
            int g = a - 8;
            if ((b & 67108864) != 0 && (route(g) & 67108864) == 0) flash(g, desired(g) ^ (b & 33554431));
            setHeapInt(96 + g * 4, b); routeSeen = routeSeen | (1 << g);
        }
        if (a >= 24 && a < 49 && b < 134217728)
        { setHeapInt(160 + (a - 24) * 4, b); sourceSeen = sourceSeen | (1 << (a - 24)); }
        if (a >= 64 && a < 264)
        {
            int source = (a - 64) / 8, chunk = (a - 64) % 8;
            for (int c = 0; c < 4; ++c) setHeapByte(276 + source * 32 + chunk * 4 + c, (b >> (c * 7)) & 127);
            setHeapByte(1076 + source, getHeapByte(1076 + source) | (1 << chunk));
        }
    }
    ready();
}
int glyph(int c)
{
    if (c >= 97 && c <= 122) c = c - 32;
    if (c == 65) return 23530;
    if (c == 66) return 15083;
    if (c == 67) return 25166;
    if (c == 68) return 15211;
    if (c == 69) return 29391;
    if (c == 70) return 4815;
    if (c == 71) return 27470;
    if (c == 72) return 23533;
    if (c == 73) return 29847;
    if (c == 74) return 11044;
    if (c == 75) return 23277;
    if (c == 76) return 29257;
    if (c == 77) return 23549;
    if (c == 78) return 24573;
    if (c == 79) return 11114;
    if (c == 80) return 4843;
    if (c == 81) return 28522;
    if (c == 82) return 23275;
    if (c == 83) return 14478;
    if (c == 84) return 9367;
    if (c == 85) return 31597;
    if (c == 86) return 11117;
    if (c == 87) return 24557;
    if (c == 88) return 23213;
    if (c == 89) return 9389;
    if (c == 90) return 29351;
    if (c == 48) return 31599;
    if (c == 49) return 29850;
    if (c == 50) return 29347;
    if (c == 51) return 14499;
    if (c == 52) return 18925;
    if (c == 53) return 14543;
    if (c == 54) return 31694;
    if (c == 55) return 9383;
    if (c == 56) return 31727;
    if (c == 57) return 14831;
    if (c == 45) return 448;
    if (c == 43) return 1488;
    if (c == 32) return 0;
    return 8355;
}
int nameColumn(int source, int column)
{
    if (column % 4 == 3) return 0;
    int bits = glyph(getHeapByte(276 + source * 32 + column / 4)), result = 0;
    for (int y = 0; y < 5; ++y) if ((bits & (1 << (y * 3 + column % 4))) != 0) result = result | (1 << y);
    return result;
}
void drawName()
{
    if (named < 0 || !held(8 + named))
    {
        named = -1;
        for (int s = 0; s < 25; ++s) if (held(8 + s)) { named = s; break; }
        nameAt = getMillisecondCounter();
    }
    if (named < 0 || getHeapByte(1076 + named) != 255) return;
    int length = 0;
    while (length < 32 && getHeapByte(276 + named * 32 + length) != 0) ++length;
    length = length * 4;
    if (length == 0) return;
    int start = ((getMillisecondCounter() - nameAt) / 160) % (length + 8);
    for (int x = 0; x < 15; ++x)
    {
        int column = (start + x) % (length + 8);
        if (column < length)
            for (int y = 0; y < 5; ++y)
                if ((nameColumn(named, column) & (1 << y)) != 0) fillPixel(0xffb0b0b0, x, y);
    }
}
void drawScene()
{
    if (resync && getMillisecondCounter() - resyncAt >= 1000)
    { resync = 0; resyncAt = getMillisecondCounter(); sendCC(15, 110, 19); }
    fillRect(0xff000000, 0, 0, 15, 15);
    if (!announced) return;
    int group = heldGroup();
    bool label = false;
    if (group == 127) for (int s = 0; s < 25; ++s) if (held(8 + s)) label = true;
    float pulse = 1.0 - abs(float(getMillisecondCounter() % 1000) / 500.0 - 1.0);
    bool flashing = getMillisecondCounter() - flashAt < 250;
    for (int g = 0; g < 8; ++g)
    {
        int facts = getHeapInt(g * 4);
        if ((facts & 2097152) == 0) continue;
        float amount = label ? .03 : group == g ? .65 : .12;
        if (pending(g)) amount = group == g ? .45 + .2 * pulse : .12 + .35 * pulse;
        int c = flashing && flashGroup == g ? 0xffff2020 : rgb(facts);
        fillRect(dim(c, amount), g % 4 * 4, g / 4 * 2, 3, 2);
    }
    for (int s = 0; s < 25; ++s)
    {
        int c = rgb(getHeapInt(160 + s * 4));
        float empty = sourceAvailable(s, group) ? .12 : .025;
        bool wanted = group < 8 && (desired(group) & (1 << s)) != 0;
        float upper = wanted ? .65 : empty;
        float lower = upper;
        if (group < 8 && pending(group))
        {
            float previous = (route(group) & (1 << s)) != 0 ? .65 : empty;
            lower = previous + (upper - previous) * pulse;
        }
        if (held(8 + s) && group >= 8) { upper = .8; lower = .8; }
        if (flashing && (flashMask & (1 << s)) != 0 && (group == flashGroup || group == 127)) c = 0xffff2020;
        fillRect(dim(c, upper), s % 5 * 3, 5 + s / 5 * 2, 3, 1);
        fillRect(dim(c, lower), s % 5 * 3, 6 + s / 5 * 2, 3, 1);
    }
    if (label) drawName();
}

// The first blocked frame precedes the grant by a complete repaint callback.
// Original contacts finish before locking; later orphaned moves/ends own no role.
void repaint()
{
    drawScene();
    if (preparation != 0 && down == 0)
    {
        if (preparationPhase == 1) {  sendIntent(58, preparation); }
        if (preparationPhase < 2) ++preparationPhase;
        fillRect(0xffffc000, 4, 7, 7, 1);
    }
}
