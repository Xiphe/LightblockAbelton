// Main loop/Constants overview, held mixer and recording controls.
// Protocol19/A9. Live owns gestures and musical state.
// No saved-default or firmware writes. Code+heap checked before upload.
// State0..179, RX180..203, clocks204..347, touchXY348..411, pending412..427,
// sequence428..443, clockrevisions444..452, UIrevision453, meter454..455; UIflags/monitor are globals.
#heapsize: 456
int nonGroupTouches;
int rxGroup;
int rxKind;
int rxCursor;
int rxRevision;
bool announced;
int fresh[12];
int clockAt[9];
int sentAt[16];
int pulseAt;
float lastPosition;
float metronomePosition;
bool pulseReady;
int swingParity;
int downFingers;
int ready;
int helloAt;
int uiAt;
int uiFlags;
int monitorGroup;
int view;
int selectedGroup;
int recordingGroup;
int chordGroups;
int markerKey;
int markerFrom;
int markerCount;
int markerAt;
// Geometry only: the host owns gesture recognition and preview flags.
int guideFinger;
int guideX;
int guideY;
bool guideEnabled;

int field(int group, int number) { return getHeapByte(group * 15 + number); }
int timed(int group, int number) { return getHeapByte(204 + group * 16 + number); }
int read21(int offset)
{
    int value = getHeapInt(offset);
    return (value & 127) | ((value >> 1) & 0x3f80) | ((value >> 2) & 0x1fc000);
}

int clockNumber(int group, int number) { return read21(204 + group * 16 + number); }
bool freshGroup(int group)
{
    int stamp = fresh[group];
    return stamp != 0 && getMillisecondCounter() - stamp < 3000;
}
int clockAge(int group) { return getMillisecondCounter() - clockAt[group]; }
bool available(int group)
{ return ready == 3 && freshGroup(group) && field(group, 0) > 0; }
bool capable(int group, int capability)
{
    return available(group) && (field(group, 11) & capability) != 0;
}

int colour(int group)
{
    // Expand the host's 7-bit RGB channels to 8-bit LED channels, 0..254.
    return makeARGB(255, field(group, 3) << 1, field(group, 4) << 1, field(group, 5) << 1);
}

int dim(int colour, float amount)
{
    return blendARGB(0xff000000, (int(amount * 255.0) << 24) | (colour & 0xffffff));
}





int touchX(int finger) { return getHeapBits(2784 + finger * 32, 16); }
int touchY(int finger) { return getHeapBits(2800 + finger * 32, 16); }
int groupFingers() { return downFingers & ~nonGroupTouches; }





void resetConnection()
{
    announced = false;
    rxKind = 0;
    nonGroupTouches = downFingers;
    guideFinger = downFingers == 0 ? -1 : -2;
    guideEnabled = false;
    ready = 0;
    view = 0;
    chordGroups = 0;
    markerKey = -1;
    uiAt = 0;
    uiFlags = 0;
    monitorGroup = 127;
    pulseReady = false;
    for (int group = 0; group < 9; ++group)
    {
        setHeapByte(204 + group * 16, 0);
        setHeapByte(444 + group, 0);

    }
    for (int group = 0; group < 12; ++group) fresh[group] = 0;
    setHeapByte(453, 0);
    for (int finger = 0; finger < 16; ++finger) setHeapByte(412 + finger, (downFingers & (1 << finger)) != 0 ? 20 : 0);
}

void initialise()
{
    for (int byte = 0; byte < 456; ++byte) setHeapByte(byte, 0);
    downFingers = 0;
    pulseAt = -1000;
    resetConnection();
    helloAt = getMillisecondCounter();
    sendCC(15, 110, 19);
}

void copyBytes(int target, int source, int count)
{
    for (int n = 0; n < count; ++n) setHeapByte(target + n, getHeapByte(source + n));
}
void snapshot(int group)
{
    if (getHeapByte(180) > 2 || (getHeapByte(181) != 0 && getHeapByte(181) != 127)
        || getHeapByte(191) > 31 || getHeapByte(192) > 4) return;
    copyBytes(group * 15, 180, 15);
    fresh[group] = getMillisecondCounter();
}

void acceptUI()
{
    int mode = getHeapByte(180);
    int selected = getHeapByte(181);
    int recording = getHeapByte(182);
    int flags = getHeapByte(184);
    int preview = flags & 44;
    if (mode > 2 || (selected > 11 && (selected != 127 || mode == 1))
        || (recording > 7 && (recording != 127 || mode == 2))
        || (getHeapByte(187) > 7 && getHeapByte(187) != 127)
        || flags > 63 || getHeapByte(186) > 31 || (preview & (preview - 1)) != 0
        || (mode == 2 && (getHeapByte(185) > 111 || getHeapByte(186) != 0))
        || (preview != 0 && (mode != 0 || selected == 127
            || getHeapByte(185) != 0 || getHeapByte(186) != 0))) return;
    if (mode != 0 || getHeapByte(185) != 0 || getHeapByte(186) != 0)
    {
        guideFinger = downFingers == 0 ? -1 : -2;
        guideEnabled = false;
    }
    else if (preview == 0) guideEnabled = false;
    else if ((uiFlags & 44) == 0 && guideFinger >= 0)
    {
        if (groupFingers() == (1 << guideFinger)) guideEnabled = true;
    }
    if (view != 2 && mode == 2) pulseReady = false;
    uiFlags = flags;
    monitorGroup = getHeapByte(187);
    view = mode;
    selectedGroup = selected;
    recordingGroup = recording;
    // Overview stores the pending mute mask. Recording reuses the same word
    // for completed bars (low7bits) bound to the presentation's take ID.
    chordGroups = getHeapByte(185) | ((mode == 2 ? getHeapByte(183) : getHeapByte(186)) << 7);
    uiAt = getMillisecondCounter();
}


void sendTouch(int finger, int kind)
{
    int seq = getHeapByte(428 + finger);
    int pending = getHeapByte(412 + finger);
    int x = touchX(finger), y = touchY(finger);
    int contextGroup = view == 2 ? recordingGroup : view == 1 ? selectedGroup : 0;
    int canAccept = view == 2 && (pending & 28) == 0 && available(recordingGroup) && (uiFlags & 2) != 0 ? 64 : 0;
    sendCC(finger, 20, seq);
    sendCC(finger, 21, kind | (pending & 28) | (view == 1 && contextGroup >= 8 ? 64 : 0));
    sendCC(finger, 22, x & 127);
    sendCC(finger, 23, (x >> 7) | (view << 4) | canAccept);
    sendCC(finger, 24, y & 127);
    sendCC(finger, 25, (y >> 7) | ((contextGroup & 7) << 4));
    sendCC(finger, 26, seq);
    setHeapByte(428 + finger, (seq + 1) & 127);
    setHeapByte(412 + finger, pending & ~3);
    sentAt[finger] = getMillisecondCounter();
}

void rememberTouch(int finger, float x, float y)
{
    int px = int(clamp(0.0, 1919.0, x * 960.0));
    int py = int(clamp(0.0, 1919.0, y * 960.0));
    setHeapInt(348 + finger * 4, px | (py << 16));
}

void touchEvent(int kind, int index, float x, float y)
{
    if (index < 0 || index >= 16) return;
    int bit = 1 << index;
    bool held = (downFingers & bit) != 0;
    int previousGroups = groupFingers();
    if (kind == 1)
    {
        downFingers = downFingers | bit;
        nonGroupTouches = nonGroupTouches & ~bit;
    }
    else if (kind == 3)
    {
        downFingers = downFingers & ~bit;
        nonGroupTouches = nonGroupTouches & ~bit;
        if (index == guideFinger || groupFingers() == 0) { guideFinger = -2; guideEnabled = false; }
    }
    else if (!held) return;
    if (ready != 3 || uiAt == 0 || getMillisecondCounter() - uiAt >= 3000 || (kind == 3 && !held))
    {
        if (kind == 1) { setHeapByte(412 + index, 20); nonGroupTouches = nonGroupTouches | bit; }
        return;
    }
    rememberTouch(index, x, y);
    if (kind == 1)
    {
        int px = touchX(index) / 128, py = touchY(index) / 128;
        int r = 0;
        if (view == 0)
        {
            r = 5;
            if (px % 4 < 3 && ((py < 7 && py % 4 < 3) || (py >= 8 && py < 10))) r = 6;

        }
        setHeapByte(412 + index, r << 2);
        if (r != 6) nonGroupTouches = nonGroupTouches | bit;
        else
        {
            guideEnabled = false; guideFinger = -2;
            if (previousGroups == 0) { guideFinger = index; guideX = px; guideY = py; }
        }
    }

    if (kind == 2) setHeapByte(412 + index, (getHeapByte(412 + index) & ~3) | 2);
    if (kind != 2 || getMillisecondCounter() - sentAt[index] >= 40) sendTouch(index, kind);
}

void touchStart(int i, float x, float y, float z, float vz) { touchEvent(1, i, x, y); }
void touchMove(int i, float x, float y, float z, float vz) { touchEvent(2, i, x, y); }
void touchEnd(int i, float x, float y, float z, float vz) { touchEvent(3, i, x, y); }

void updateModel()
{
    int now = getMillisecondCounter();
    bool any = false;
    for (int group = 0; group < 12; ++group)
    {
        if (fresh[group] != 0 && !freshGroup(group))
        {
            fresh[group] = 0;
            if (group < 8) setHeapByte(204 + group * 16, 0);
        }
        if (fresh[group] != 0) any = true;
    }
    if (uiAt != 0 && now - uiAt >= 3000)
    {
        nonGroupTouches = 0;
        view = 0;
        chordGroups = 0;
        uiAt = 0;
        downFingers = 0;
        guideFinger = -1;
        guideEnabled = false;
    }
    if (guideEnabled && selectedGroup >= 0 && selectedGroup < 8)
    {
        if (!available(selectedGroup))
        {
            guideFinger = downFingers == 0 ? -1 : -2;
            guideEnabled = false;
        }
    }
    if (!any && now - helloAt >= 1000)
    {
        resetConnection();
        sendCC(15, 110, 19);
        helloAt = now;
    }
    for (int finger = 0; finger < 16; ++finger)
    {
        if ((downFingers & (1 << finger)) != 0 && uiAt != 0
            && now - sentAt[finger] >= ((getHeapByte(412 + finger) & 3) == 2 ? 40 : 250)) sendTouch(finger, 2);
    }
}

float controlLevel(int group, int number) { return float(field(group, (0x14e4a0e6 >> (number * 5)) & 31)) / 127.0; }

int timingFor(int group)
{
    int context = timed(group, 0) & 3;
    if (context != 0 && context == field(group, 0) && timed(group, 1) == field(group, 13)) return group;
    return field(group, 0) == 1 && (timed(8, 0) & 3) == 1 ? 8 : -1;
}

float positionNow(int index)
{
    float position = float(clockNumber(index, 5));
    if ((timed(index, 0) & 4) != 0)
    {
        int age = clamp(0, 1000, clockAge(index));
        int tempo = timed(index, 14) + (timed(index, 15) << 7);
        position += float(age) * float(tempo) / 15000.0;
    }
    float span = float(clockNumber(index, 2));
    // The last queued bar drains to its target, then holds without wrapping.
    // This never schedules recording or changes the independent global clock.
    if (view == 2 && index == recordingGroup && field(index, 12) == 1 && (chordGroups & 127) == 0)
        return min(position, span);
    return position - float(int(position / span)) * span;
}

float progressFor(int group)
{
    int index = timingFor(group);
    if (index >= 0) return positionNow(index) / float(clockNumber(index, 2));
    return float(field(group, 2)) / 127.0;
}

void acceptClock(int group)
{
    int context = getHeapByte(180) & 3;
    int previousContext = timed(group, 0) & 3;
    setHeapByte(204 + group * 16, 0);
    if (context == 0) return;
    if (context > 2 || getHeapByte(180) > (group == 8 ? 14 : 6) || (group == 8 && (context != 1 || getHeapByte(181) != 0))) return;
    if (group < 8 && (!available(group) || getHeapByte(181) != field(group, 13)
        || context != field(group, 0))) return;
    // Decode candidate numeric fields directly from the isolated RX buffer.
    int span = read21(182);
    int position = read21(185);
    int first = read21(188);
    int bar = read21(191);
    int tempo = getHeapByte(194) + (getHeapByte(195) << 7);
    int numerator = getHeapByte(196);
    int denominator = getHeapByte(197);
    if (span <= 0 || bar <= 0 || tempo == 0 || numerator == 0
        || numerator > 99 || denominator > 16 || ((0x10116 >> (denominator & 31)) & 1) == 0
        || first > bar || position >= span) return;
    if (abs(bar - numerator * 256 / denominator) > 1
        || (context == 1 && abs(span - bar) > 1
            && !(group < 8 && field(group, 12) == 1 && span == bar * 8 && first == 0))) return;
    if (group == 8)
    {
        if (previousContext != context || clockAge(8) >= 1000
            || clockNumber(8, 11) != bar || clockNumber(8, 8) != first) pulseReady = false;
        setHeapByte(454, numerator);
        setHeapByte(455, denominator);
    }
    copyBytes(204 + group * 16, 180, 16);
    clockAt[group] = getMillisecondCounter();
}

void ringPixel(int x, int y, int position, int colour)
{
    int point = (0x489a6210 >> (position * 4)) & 15;
    fillPixel(colour, x + (point & 3), y + (point >> 2));
}

bool previewActive()
{
    if (!guideEnabled || guideFinger < 0 || view != 0 || chordGroups != 0) return false;
    return groupFingers() == (1 << guideFinger) && (uiFlags & 44) != 0;
}

void drawGuide()
{
    if (!previewActive() || (uiFlags & 32) != 0) return;
    int x = touchX(guideFinger) >> 7;
    int y = touchY(guideFinger) >> 7;
    int top = min(guideY, y);
    fillRect(0xffffffff, guideX, top, 1, min(13, max(guideY, y)) - top + 1);
    if ((uiFlags & 8) != 0 && y < 14)
        fillRect(0xffffffff, min(guideX, x), y, abs(guideX - x) + 1, 1);
}

void drawGroup(int group)
{
    int x = (group % 4) * 4;
    int y = (group / 4) * 4;
    // Host-owned short failure feedback. No view change or local retry timer.
    if ((uiFlags & 16) != 0 && selectedGroup == group)
    { fillRect(0xffff9118, x, y, 3, group >= 8 ? 2 : 3); return; }
    int effectiveMute = field(group, 1) == 127 ? 1 : 0;
    if (chordGroups != 0 && (chordGroups & (1 << group)) != 0)
        effectiveMute = 1 - effectiveMute;
    if (group >= 8)
    {
        if (available(group)) fillRect(dim(colour(group), effectiveMute == 1 ? 0.08 : 0.5), x, 8, 3, 2);
        return;
    }
    if (!available(group))
    {
        // Fresh state zero is an unassigned tile, not a connection fault.
        if (!freshGroup(group))
            glyph(0xff302000, x, y, 0x1445);
        return;
    }
    int state = field(group, 0);
    bool preview = previewActive() && selectedGroup == group;
    if (preview && (uiFlags & 8) != 0) return;
    if (preview && (uiFlags & 32) != 0)
    { glyph(0xffffff00, x, y, 0x1445); return; }
    bool armed = preview && (uiFlags & 4) != 0;
    int c = armed ? 0xffff0000 : colour(group);
    float position = progressFor(group) * 8.0;
    float ringBrightness = !armed && state == 2 && effectiveMute == 1 ? 0.3 : 1.0;
    for (int p = 0; p < 8; ++p)
    {
        float amount = clamp(0.0, 1.0, position - float(p));
        ringPixel(x, y, p, dim(c,
                  (armed ? 0.10 + 0.90 * amount : state == 1 ? 0.01 + 0.05 * amount : 0.10 + 0.55 * amount) * ringBrightness));
    }
    if (armed) fillPixel(0xffff0000, x + 1, y + 1);
    else if (state == 2)
    {
        float brightness = 0.7;
        if (effectiveMute == 1)
        {
            float pulse = float(getMillisecondCounter() % 2000) / 2000.0;
            brightness = 0.10 + 0.12 * (1.0 - abs(pulse * 2.0 - 1.0));
        }
        fillPixel(dim(effectiveMute == 1 ? 0xffffffff : c, brightness),
                  x + 1, y + 1);
    }
    else fillPixel(effectiveMute == 1 ? 0xff000000 : dim(c, 0.06), x + 1, y + 1);
}

void drawFader(int x, int width, int colour, float value)
{
    // The last occupied row fades between the established resting/lit levels.
    for (int row = 0; row < 7; ++row)
        fillRect(dim(colour, 0.08 + 0.42 * clamp(0.0, 1.0, value * 7.0 - float(row))),
                 x, (selectedGroup >= 8 ? 6 : 14) - row, width, 1);
}

void borderPixel(int position, int colour)
{
    if (position < 15) blendPixel(colour, position, 0);
    else if (position < 29) blendPixel(colour, 14, position - 14);
    else if (position < 43) blendPixel(colour, 42 - position, 14);
    else blendPixel(colour, 0, 56 - position);
}

void drawMarkers(int count, int key)
{
    int now = getMillisecondCounter();
    if (markerKey != key)
    {
        markerKey = key; markerFrom = count; markerCount = count; markerAt = now - 200;
    }
    else if (markerCount != count)
    {
        markerFrom = markerCount; markerCount = count; markerAt = now;
    }
    float progress = clamp(0.0, 1.0, float(now - markerAt) / 200.0);
    for (int dot = 0; dot < max(markerFrom, markerCount); ++dot)
    {
        bool was = dot < markerFrom;
        bool will = dot < markerCount;
        int old = was ? dot * 56 / markerFrom : dot * 56 / markerCount;
        int target = will ? dot * 56 / markerCount : old;
        float point = float(old) + float(target - old) * progress;
        int pixel = int(point);
        float fraction = point - float(pixel);
        float alpha = was ? (will ? 1.0 : 1.0 - progress) : progress;
        borderPixel(pixel, makeARGB(int(alpha * (1.0 - fraction) * 255.0), 176, 176, 176));
        if (pixel < 55) borderPixel(pixel + 1, makeARGB(int(alpha * fraction * 255.0), 176, 176, 176));
    }
}

void glyph(int colour, int x, int y, int bitmap)
{
    for (int bit = 0; bit < 25; ++bit)
        if ((bitmap & (1 << bit)) != 0) fillPixel(colour, x + bit % 5, y + bit / 5);
}



void trackBar()
{
    // Independent actual project-bar clock. Never pulse from marker pixels.
    int now = getMillisecondCounter();
    if (!globalRunning()) return;
    float span = float(clockNumber(8, 2));
    // One phase sample per repaint keeps the bar parity and swing on one side
    // of a boundary, even when the native clock advances while drawing groups.
    metronomePosition = positionNow(8);
    float current = metronomePosition - float(clockNumber(8, 8));
    if (current < 0.0) current += span;
    if (!pulseReady) { pulseReady = true; lastPosition = current; pulseAt = -1000; swingParity = 0; }
    float forward = current - lastPosition;
    float halfSpan = span * 0.5;
    if (forward < -halfSpan)
    {
        pulseAt = now;
    swingParity = swingParity ^ (getHeapByte(454) & 1);
        lastPosition = current;
    }
    else if (forward > 0.0 && forward <= halfSpan) lastPosition = current;
}

void drawMetronome()
{
    bool running = globalRunning();
    if (running)
    {
        float beat = metronomePosition * float(getHeapByte(455)) / 256.0 + float(swingParity);
        beat -= float(int(beat / 2.0)) * 2.0;
        float point = (1.0 - abs(beat - 1.0)) * 14.0;
        int x = int(point);
        float fraction = point - float(x);
        fillPixel(dim(0xffffffff, (1.0 - fraction) * 0.75), x, 14);
        if (x < 14) fillPixel(dim(0xffffffff, fraction * 0.75), x + 1, 14);
    }
    else fillPixel(0xff202020, 7, 14);
}

void repaint()
{
    updateModel(); announceReady();
    if (view != 2) markerKey = -1;
    if (ready == 3 && uiAt != 0 && view == 2) sendCC(15, 19, 0);
    trackBar();
    fillRect(0xff000000, 0, 0, 15, 15);
    if (view == 0)
    {
        for (int group = 0; group < 12; ++group) drawGroup(group);
        if (monitorGroup < 8) fillPixel(0xff3080ff, (monitorGroup % 4) * 4 + 1, (monitorGroup / 4) * 4 + 3);
        // Trial pending marker in the free gutter, alongside the future-state preview.
        if (chordGroups != 0)
        {
            for (int group = 0; group < 12; ++group)
            {
                if ((chordGroups & (1 << group)) == 0 || !available(group)) continue;
                fillPixel(0xffb0b0b0, (group % 4) * 4 + 1, (group < 8 ? (group / 4) * 4 + 3 : 10));
            }
        }
        drawGuide();
        drawMetronome();
    }
    if (view == 1)
    {
        int c = colour(selectedGroup);
        int row = selectedGroup / 4;
        for (int column = 0; column < 4; ++column) drawGroup(row * 4 + column);
        if (!capable(selectedGroup, 16)) return;
        int panY = row == 2 ? 12 : row == 0 ? 4 : 0;
        int panHeight = row == 2 ? 2 : 3;
        fillRect(dim(c, 0.08), 0, panY, 15, panHeight);
        // Horizontal relative pan: left minimum, right maximum.
        fillRect(dim(c, 0.18), 0, panY + 1, 15, 1);
        int panPosition = int(controlLevel(selectedGroup, 5) * 14.0 + 0.5);
        fillPixel(0xff404040, 7, panY + 1);
        fillRect(dim(c, 0.65), panPosition, panY, 1, panHeight);
        drawFader(0, 3, c, controlLevel(selectedGroup, 0));
        for (int fader = 1; fader < 5; ++fader)
            drawFader(fader * 3 + 1, 2, 0xffffffff, controlLevel(selectedGroup, fader));
        if (row == 2) drawMetronome();
    }
    if (view == 2)
    {
        int group = recordingGroup;
        bool canAccept = available(group) && (uiFlags & 2) != 0;
        float brightness = canAccept ? 0.5 : 0.10;
        int acceptColour = dim(0xff60ff80, brightness);
        int nextColour = dim(0xff60c0ff, capable(group, 4) ? brightness : 0.10);
        recordingButton(0xff240808, 0xffff6060, 1, 1, 0x498c9);
        recordingButton(dim(acceptColour, 0.15), acceptColour, 8, 1, 0x11510);
        recordingButton(0xff241700, 0xffffb040, 1, 8, 0x725e2);
        recordingButton(dim(nextColour, 0.15), nextColour, 8, 8, 0x8e28a8);
        if ((uiFlags & 1) != 0) { markerKey = -1; return; }
        int recording = field(group, 12);
        bool queued = recording == 1;
        float phase = 0.0;
        if (!queued) phase = progressFor(group);
        else if (available(group) && field(group, 13) == (chordGroups >> 7)
            && (timed(group, 0) & 3) == field(group, 0) && timed(group, 1) == field(group, 13)
            && clockAge(group) < 1000
            && abs(clockNumber(group, 2) - clockNumber(group, 11) * ((chordGroups & 127) >= 8 ? 8 : 1)) <= 1)
            phase = 1.0 - positionNow(group) / float(clockNumber(group, 2));
        float position = phase * 56.0;
        int progressColour = (uiFlags & 16) != 0 ? 0xffff9118 : queued ? 0xffff0000 : colour(group);
        for (int pixel = 0; pixel < 56; ++pixel)
        {
            float amount = clamp(0.0, 1.0, position - float(pixel));
            borderPixel(pixel, dim(progressColour, 0.08 + 0.57 * amount));
        }
        if (recording >= 1 && recording <= 3)
        {
            int completed = chordGroups & 127;
            if (available(group) && field(group, 13) == (chordGroups >> 7) && (!queued || phase > 0.0))
            {
                // Top left marks the current first bar before any bar completes.
                int count = queued && completed >= 8 ? 8 : completed % 8 + 1;
                drawMarkers(count, (chordGroups >> 7) * 16 + group * 2 + (queued ? 0 : 1));
                // Each eight-bar block moves into the central control gap.
                for (int block = 0; block < completed / 8; ++block)
                    fillPixel(0xffb0b0b0, 7, 13 - block);
            }
            else markerKey = -1;
        }
        else markerKey = -1;
        int now = getMillisecondCounter();
        if (!globalRunning()) return;
        int elapsed = now - pulseAt;
        if (elapsed >= 0 && elapsed < 160)
        {
            int white = makeARGB(255 - elapsed * 255 / 160, 255, 255, 255);
            blendRect(white, 0, 0, 15, 1);
            blendRect(white, 0, 14, 15, 1);
            blendRect(white, 0, 1, 1, 13);
            blendRect(white, 14, 1, 1, 13);
        }
    }
}

// 559isalignmentpadding; nativewordsscratch560..411, overwrittenperevent.




// One semantic unit is delivered in one checksummed SDK packet. Interleaved
// partial units are explicitly discarded; no mixed-channel data can commit.


bool globalRunning() { return (timed(8, 0) & 7) == 5 && clockAge(8) < 1000; }
void recordingButton(int back, int fore, int x, int y, int bits)
{ fillRect(back, x, y, 6, 6); glyph(fore, x + 1, y + 1, bits); }

// Native whole units; any interleaving partial record is discarded fail-closed.
// A8 byte-lanes, metadataonlyfixedcompatibleHELLO, old112/113have no visual fields.
void handleMessage(int m0, int m1, int header)
{
    int previousKind = rxKind;
    rxKind = 0;
    if ((header & 255) != 169 || (header & 0xff000000) != 0
        || ((m0 | m1) & 0x80808080) != 0) return;
    int kind = (header >> 8) & 7;
    int group = (header >> 11) & 15;
    int part = (header >> 15) & 3;
    int revision = (header >> 17) & 127;
    if (kind > 3 || group > 12 || (kind == 0 && group == 12)
        || (kind == 1 && group >= 8 && group != 12) || (kind >= 2 && group != 12)) return;
    if (group == 12) group = 8;
    if (kind == 3)
    {
        if (part != 0 || revision != 0 || m0 != 274 || m1 != 0) return;
        resetConnection(); ready = 3; return;
    }
    if (ready != 3) return;
    int last = kind == 0 ? 1 : kind == 1 ? 2 : 0;
    if (part > last) return;
    if (part == last)
    {
        if (kind == 1 && ((m0 & 0xffff0000) != 0 || m1 != 0)) return;
        if (kind == 0 && (m1 & 0xff000000) != 0) return;
    }
    if (part == 0)
    {
        rxGroup = group; rxRevision = revision;
    }
    else if (previousKind != kind + 1 || rxGroup != group || rxRevision != revision || rxCursor != part)
    { rxKind = 0; return; }
    setHeapInt(180 + part * 8, m0); setHeapInt(184 + part * 8, m1);
    if (part < last) { rxKind = kind + 1; rxCursor = part + 1; return; }
    if (kind == 0) snapshot(group);
    else
    {
        int previous = kind == 1 ? 444 + group : 453;
        if (getHeapByte(previous) == revision + 1) return;
        setHeapByte(previous, revision + 1);
        if (kind == 1) acceptClock(group); else acceptUI();
    }
}

void announceReady()
{
    if (announced || ready != 3 || uiAt == 0 || getMillisecondCounter() - uiAt >= 3000
        || (timed(8, 0) & 3) != 1 || clockAge(8) >= 1000) return;
    for (int g = 0; g < 12; ++g) if (!freshGroup(g)) return;
    announced = true; sendCC(15, 108, 34);
}
