// Contacts, gestures, views and optimistic values stay local. No host-owned UI.
// Heap:72 desired/observed/sequence bytes,12 facts,9 clocks,16 four-byte contacts.
// A group contact stores role2 + X11 + Y11 bits. A parameter stores role2,
// absolute key7, one-axis origin11 and captured value7; recording uses action/token.
// Capture byte3 is disjoint from the packed coordinate/key fields.
#heapsize: 436
// Reuse these exact literals instead of repeating32-bit immediates in bytecode.
int allBits;
float one;
int down;
int preparation;
int preparationPhase;
int anchorAt;
int anchor;
int view;
int selected;
int parameterBase;
int chord;
int batch;
int moved;
int leg;
int elbow;
int guide;
int muted;
int mutePending;
int clearPending;
int clearUntil;
int muteSequence;
int sequence;
int epoch;
int resync;
int resyncAt;
int revision;
int sentAt;
int tempo;
int meter;
int recGroup;
int token;
int tokenCounter;
int nextToken;
int recPhase;
int recAction;
int recSequence;
int recAt;
int recMeasure;
int recBar;
int cancelledToken;
int flashGroup;
int flashAt;
int pulseAt;
float lastPosition;
float metroPosition;
int pulseReady;
int parity;
int markerKey;
int markerFrom;
int markerCount;
int markerAt;
int guideX;
int guideY;
int monitor;

int finger(int f) { return 372 + f * 4; }
void contacts() { int count = 0, bits = down; while (bits != 0) { bits = bits & (bits - 1); ++count; } sendCC(15, 106, count); }


int coordinate(int f, int axis) { return (getHeapInt(finger(f)) >> (2 + axis * 11)) & 2047; }
int facts(int g)
{
    int f = getHeapInt(216 + g * 4);
    if (bool((clearPending & (1 << g))) && getMillisecondCounter() >= clearUntil)
    {
        clearPending = clearPending & ~(1 << g); f = f | ((f >> 9) & 4194304);
        setHeapInt(216 + g * 4, f);
    }
    return f;
}
bool hasSource(int g) { return bool(((meter >> (16 + g)) & 1)); }
bool available(int g) { return g < 12 && bool((facts(g) & 2097152)); }
int colour(int g)
{
    int c = facts(g);
    return ((c & 127) << 17) | ((c & 16256) << 2) | ((c >> 13) & 254);
}
int dim(int c, float amount) { return blendARGB(0xff000000, (int(amount * 255.0) << 24) | (c & 0xffffff)); }
int groupAt(int x, int y) { return ((x >> 7) & 3) >= 3 ? 12 : y < 896 && ((y >> 7) & 3) < 3 ? (x >> 9) + (y >> 9) * 4 : (y >> 8) == 4 ? (x >> 9) + 8 : 12; }

bool owned(int key)
{
    for (int f = 0; f < 16; ++f) if (bool((down & (1 << f))) && (getHeapInt(finger(f)) & 511) == (2 | (key << 2))) return true;
    return false;
}
// Logical keys128..151 use the second semantic MIDI channel.
int sendIntent(int key, int value)
{
    int channel = key >> 7; key = key & 127;
    sequence = (sequence + 1) & 127;
    sendCC(channel, 69, epoch); sendCC(channel, 70, sequence); sendCC(channel, 71, key);
    sendCC(channel, 72, value & 127); sendCC(channel, 73, value >> 7); sendCC(channel, 74, sequence);
    return sequence;
}
bool pending(int key) { return (getHeapByte(144 + key) | getHeapByte(key)) >= 128; }
void sendParameter(int key)
{
    int value = getHeapByte(key) & 127;
    setHeapByte(144 + key, sendIntent(key + int(key >= 48) * 80, value) | 128);
    setHeapByte(key, value); sentAt = getMillisecondCounter();
}
void flushParameters()
{
    for (int key = 0; key < 72; ++key) if (getHeapByte(key) >= 128) sendParameter(key);
}
void flash(int g) { flashGroup = g; flashAt = getMillisecondCounter(); }
void muteBatch(int mask)
{
    if (!bool(mask)) return;
    muted = muted ^ mask; mutePending = mutePending | mask;
    muteSequence = sendIntent(56, mask);
}
void busy() { sendCC(15, 107, int(view == 2)); }
void clearContacts()
{
    anchor = allBits; chord = 0; batch = 0; guide = 0;
    for (int f = 0; f < 16; ++f) setHeapByte(finger(f), 0);
}

void updateHold()
{
    if (!bool(view) && anchor >= 0 && !moved && !chord && getMillisecondCounter() - anchorAt >= 500)
        view = 1;
}

void touchEvent(int kind, int f, float x, float y)
{
    if (bool(preparationPhase) || bool(f >> 4)) return;
    int px = int(clamp(0.0, 1919.0, x * 960.0)), py = int(clamp(0.0, 1919.0, y * 960.0));
    int bit = 1 << f;
    int contactOffset = finger(f);
    updateHold();
    if (kind == 1)
    {
        if (f == anchor && !chord) { clearContacts(); view = 0; }
        down = down | bit;
        int data = (px << 2) | (py << 13);
        if (!bool(view))
        {
            int g = groupAt(px, py);
            if (available(g))
            {
                data = data | 1;
                if (chord) batch = batch ^ (1 << g);
                else if (anchor >= 0)
                    { chord = 1; batch = (1 << selected) ^ (1 << g); guide = 0; }
                else { anchor = f; anchorAt = getMillisecondCounter(); selected = g; parameterBase = g * 6; moved = 0; leg = 0; guide = 0; }
            }
        }
        else if (view == 1)
        {
            int control = 6;
            int row = ((selected >> 2) ^ 1) << 9;
            if (py >= row && py < row + (selected < 8 ? 384 : 256)) control = 1;
            if (selected < 8 ? py >= 1024 : py < 896) control = px < 384 ? 0 : !bool(((px >> 7) % 3)) ? 6 : px / 384 + 1;
            if (control < 6 && getHeapByte(72 + parameterBase + control) < 128)
            {
                int key = parameterBase + control;
                data = 2 | (key << 2) | ((control == 1 ? px : py) << 9) | ((getHeapByte(key) & 127) << 24);
            }
        }
        else
        {
            int xx = (px >> 7), yy = (py >> 7);
            if (bool(xx % 7) && bool(yy % 7))
            {
                int action = ((0x93 >> ((xx / 7 + yy / 7 * 2) * 2)) & 3) + 1;
                if ((!bool((action & 1))) || recPhase == 3)
                    data = 3 | (action << 2) | (token << 24);
            }
        }
        setHeapInt(contactOffset, data); contacts();
    }
    else if (!bool((down & bit))) return;
    int r = getHeapInt(contactOffset);
    int contactKey = (r >> 2) & 127; r = r & 3;
    if (r == 2)
    {

        int axis = int(contactKey % 6 != 1);
        int delta = (!bool(axis) ? px : py) - ((getHeapInt(contactOffset) >> 9) & 2047);
        if (axis) delta = -delta;
        int value = int(clamp(0.0, 127.0, float(getHeapByte(contactOffset + 3)) + float(delta) * 127.0 / float(896 * (2 - axis))) + .5);
        if (value != (getHeapByte(contactKey) & 127))
        {
            setHeapByte(contactKey, value | 128);
            if (getMillisecondCounter() - sentAt >= 40) flushParameters();
        }

        if (kind == 3 && getHeapByte(contactKey) >= 128) sendParameter(contactKey);
    }
    if (f == anchor && r == 1 && !chord)
    {
        guideX = px; guideY = py;
        int dx = px - coordinate(f, 0), dy = py - coordinate(f, 1);
        if (abs(dx) > 128 || abs(dy) > 128) moved = 1;
        if (!bool(view) && selected < 8)
        {
            if (groupAt(px, py) == selected || dy < 256)
                { leg = 0; guide = int(groupAt(px, py) != selected && abs(dx) >= 256 && abs(dy) < 256) * 3; }
            else if (!leg)
                { if (abs(dx) <= 192) { leg = 1; elbow = px; guide = 1; }
            }
            else guide = abs(px - elbow) >= 256 ? 2 : 1;
        }
    }
    if (kind != 3) return;
    down = down & ~bit;
    if (r == 2 && !pending(contactKey) && !owned(contactKey))
        setHeapByte(contactKey, getHeapByte(72 + contactKey) & 127);
    if (r == 1)
    {
        if (chord)
        {
            setHeapByte(contactOffset, 0);

            bool groupHeld = false;
            for (int f = 0; f < 16; ++f) if (bool((down & (1 << f))) && (getHeapByte(finger(f)) & 3) == 1) groupHeld = true;

            if (!groupHeld) { muteBatch(batch); clearContacts(); }
        }
        else if (f == anchor)
        {
            if (view == 1) { flushParameters(); view = 0; clearContacts(); }
            else if (guide == 1) {
                clearContacts();
                if ((meter & 16384) && hasSource(selected)) {
                    view = 2; recGroup = selected; tokenCounter = (tokenCounter + 1) & 127;
                    token = tokenCounter; nextToken = cancelledToken = markerKey = allBits; recPhase = 1; recAction = 0; recMeasure = 0;
                    recSequence = sendIntent(64 + selected * 5, token); busy();

                }
            }
            else if (guide == 3) { monitor = selected | (sendIntent(57, selected) << 3); clearContacts(); }
            else if (guide == 2)
            {
                int seq = sendIntent(104 + selected, 0);
                int f = facts(selected);
                setHeapInt(216 + selected * 4, (f & 12582911) | (seq << 24) | ((f & 4194304) << 9));
                if (!bool(clearPending)) clearUntil = getMillisecondCounter() + 2000;
                clearPending = clearPending | (1 << selected); clearContacts();
            }
            else { if (!moved) muteBatch(1 << selected); clearContacts(); }
        }
    }
    else if (r == 3 && view == 2 && getHeapByte(contactOffset + 3) == token)
    {
        int action = contactKey;
        if ((!bool((action & 1))) || recPhase == 3) {
            int value = token;
            // Actions 1..4: Retry and Next allocate a replacement token.
            if ((action >> 1) == 1)
            {
                tokenCounter = (tokenCounter + 1) & 127; nextToken = tokenCounter;
                value = value | (nextToken << 7);
            }
            recAction = action; recSequence = sendIntent(64 + recGroup * 5 + action, value);
            if (action == 4) { cancelledToken = token; view = 0; clearContacts(); busy(); }
            else if (action == 2) { recPhase = 1; markerKey = allBits; }
            else if ((action & 1)) recPhase = 4;
        }
    }
    setHeapByte(contactOffset, 0); contacts();
}

void touchStart(int i, float x, float y, float z, float vz) { touchEvent(1, i, x, y); }
void touchMove(int i, float x, float y, float z, float vz) { touchEvent(2, i, x, y); }
void touchEnd(int i, float x, float y, float z, float vz) { touchEvent(3, i, x, y); }
void initialise()
{
    allBits = -1; one = 1.0;
    preparation = 0; preparationPhase = 0;
    for (int i = 0; i < 436; ++i) setHeapByte(i, 0);
    for (int i = 0; i < 72; ++i) setHeapByte(72 + i, 128);
    monitor = anchor = recGroup = nextToken = cancelledToken = allBits; selected = 0; parameterBase = 0;
    tempo = 15360; meter = 516; flashAt = pulseAt = -1000; markerKey = allBits;
}
float clockPosition(int g)
{
    int address = 264 + g * 12;
    int span = getHeapInt(address);
    if (!span) return 0.0;
    // Keep fixed1/256-beat units until the final result; the256scale is exact.
    float value = float(getHeapInt(address + 4));
    if ((meter & 16384)) value += float(getMillisecondCounter() - getHeapInt(address + 8)) * float(tempo) / 30000.0;
    float length = float(span);
    return (value - float(int(value / length)) * length) / 256.0;
}

void handleMessage(int a, int b, int header)
{
    if ((header & 255) != 242 || header < 0 || bool((a | b) >> 28)) return;
    int kind = (header >> 8) & 7, gen = (header >> 11) & 127, rev = (header >> 18) & 8191;
    if (!bool(gen) || (bool(kind) && gen != epoch)) return;
    int distance = (rev - revision) & 8191;
    if (gen == epoch && (!bool(distance) || bool(distance & 4096))) return;
    if (bool(kind) && distance > 1) resync = 1;
    revision = rev;
    if (!bool(kind))
    {
        if (gen != epoch) { preparation = 0; preparationPhase = 0; sequence = a & 127; clearPending = 0; mutePending = 0; nextToken = recSequence = allBits; }
        epoch = gen; resync = 0;
        for (int key = 0; key < 72; ++key) if (pending(key)) sendParameter(key);
        if (monitor >= 0) monitor = (monitor & 7) | (sendIntent(57, monitor & 7) << 3);
        sendCC(15, 108, 34); contacts(); busy(); return;
    }
    if (kind == 1 && a < 72 && b <= 128)
    {
        setHeapByte(72 + a, b);
        if (!pending(a) && !owned(a)) setHeapByte(a, b & 127);
    }
    if (kind == 7) { kind = 2; b = 16383; }
    if (kind == 2)
    {
        // A Littlefoot bool cast need not normalize to1; this bit must be numeric0/1.
        bool bank = (a >> 14) & 1;
        int key = (a & 127) + int(bank) * 48, seq = (a >> 7) & 127;
        if ((key < 48 || bank) && key < 72 && getHeapByte(144 + key) == seq + 128 && getHeapByte(key) < 128)
        {
            setHeapByte(144 + key, seq);
            if (b == 16383) { flash(key / 6); b = getHeapByte(72 + key); }
            else if (b < 128) setHeapByte(72 + key, b);
            if (b <= 128 && !owned(key)) setHeapByte(key, b & 127);
        }
        if (bank) return;
        if (key == 57 && monitor >= 0 && seq == (monitor >> 3))
            { if (b < 8) meter = (meter & 0xffffff) | ((b + 1) << 24); else flash(monitor & 7); monitor = allBits; }
        if (key == 56 && seq == muteSequence)
            { mutePending = 0; if (b < 4096) muted = b; else flash(selected); }
        if ((key >> 3) == 13)
        {
            int g = key - 104, f = facts(g);
            if (bool((clearPending & (1 << g))) && seq == ((f >> 24) & 127) && b == 16383)
            {
                clearPending = clearPending & ~(1 << g);
                flash(g); setHeapInt(216 + g * 4, f | ((f >> 9) & 4194304));
            }
        }
        if (key >= 64 && key < 104 && seq == recSequence && b == 16383)
        {
            flash(recGroup); nextToken = allBits;
            if (!bool(recAction) && recPhase < 3) { view = 0; recPhase = 0; busy(); }
            // A rejected action can leave Live recording the admitted following take.
            else { recAction = cancelledToken = allBits; }
        }
    }
    if (kind == 3 && a < 12 && !bool(b >> 24))
    {
        if (!bool((b & 4194304))) clearPending = clearPending & ~(1 << a);
        if (bool((clearPending & (1 << a)))) b = (b & 12582911) | (facts(a) & 0xff000000);
        setHeapInt(216 + a * 4, b);
        if (!bool((mutePending & (1 << a)))) muted = (muted & ~(1 << a)) | (((b >> 23) & 1) << a);
    }
    if (kind == 4)
    {
        int g = a & 15, span = a >> 4;
        if (g > 8 || !span || bool(span >> 21) || b >= span) return;
        if (g == 8 && span != getHeapInt(360)) pulseReady = 0;
        int address = 264 + g * 12;
        setHeapInt(address, span); setHeapInt(address + 4, b); setHeapInt(address + 8, getMillisecondCounter());
    }
    if (kind == 5)
    {
        int g = a & 7, t = (a >> 3) & 127, phase = (a >> 10) & 7, bar = a >> 13;
        if (phase > 5 || bar <= 0) return;
        if (!bool(view) && phase == 3 && t != cancelledToken && t != nextToken)
            { recGroup = g; token = t; view = 2; recAction = 0; nextToken = allBits; busy(); }
        if (view != 2 || g != recGroup) return;
        if (recSequence < 0 && phase > 0 && phase < 5) { token = t; recSequence = 0; recAction = 0; }
        if ((t == nextToken && phase >= 1 && phase <= 5) || (recAction < 0 && recPhase == 1 && phase == 3)) { token = t; nextToken = allBits; recAction = 0; }
        if (t != token) return;
        if (!bool(phase))
        {
            if (nextToken >= 0) recPhase = 1;
            else { view = 0; recPhase = 0; clearContacts(); busy(); }
            return;
        }
        if (phase == 5) { flash(g); view = 0; recPhase = 0; busy(); return; }
        if (nextToken >= 0 && recAction == 2) return;
        recPhase = recAction == 1 || recAction == 3 ? 4 : phase;
        recMeasure = b; recBar = bar; recAt = getMillisecondCounter();
    }
    if (kind == 6)
        { if (!bool(a) && b > 0) tempo = b; if (a == 1) meter = b;
          if (a == 3 && b < 16383 && b != preparation) { preparation = b; preparationPhase = 0; } }
}



void drawFader(int x, int width, int colour, float value)
{
    // The last occupied row fades between the established resting/lit levels.
    for (int row = 0; row < 7; ++row)
    fillRect(dim(colour, 0.08 + 0.42 * clamp(0.0, one, value * 7.0 - float(row))),
    x, (selected < 8 ? 14 : 6) - row, width, 1);
}

void markerPixel(int position, int colour)
{
    blendPixel(colour, clamp(0, 14, min(position, 42 - position)),
                      clamp(0, 14, min(position - 14, 56 - position)));
}

void drawMarkers(int count, int key)
{
    int now = getMillisecondCounter();
    if (markerKey != key)
    {
        markerKey = key; markerFrom = count; markerCount = count; markerAt = now;
    }
    else if (markerCount != count)
    {
        markerFrom = markerCount; markerCount = count; markerAt = now;
    }
    float progress = clamp(0.0, one, float(now - markerAt) / 200.0);
    for (int dot = 0; dot < max(markerFrom, markerCount); ++dot)
    {
        bool was = dot < markerFrom;
        bool will = dot < markerCount;
        int target = dot * 56 / (will ? markerCount : markerFrom);
        int old = was ? dot * 56 / markerFrom : target;
        float point = float(old) + float(target - old) * progress;
        int pixel = int(point);
        float fraction = point - float(pixel);
        float alpha = was ? (will ? one : one - progress) : progress;
        markerPixel(pixel, (int(alpha * (one - fraction) * 255.0) << 24) | 0xb0b0b0);
        markerPixel(pixel + 1, (int(alpha * fraction * 255.0) << 24) | 0xb0b0b0);
    }
}

void glyph(int colour, int x, int y, int bitmap)
{
    for (int bit = 0; bool(bitmap); ++bit) {
    if (bool(bitmap & 1)) fillPixel(colour, x + bit % 5, y + bit / 5);
    bitmap = bitmap >> 1; }
}

void recordingButton(int back, int fore, int x, int y, int bits)
{ fillRect(back, x, y, 6, 6); glyph(fore, x + 1, y + 1, bits); }

void drawGroup(int g)
{
    int x = g % 4 * 4, y = g / 4 * 4;
    if (!available(g)) return;
    if (flashGroup == g && getMillisecondCounter() - flashAt < 250)
        { fillRect(0xffff9118, x, y, 3, 3 - g / 8); return; }
    if (g >= 8) { fillRect(dim(colour(g), bool(((muted ^ batch) & (1 << g))) ? .15 : .7), x, y, 3, 2); return; }
    bool preview = anchor >= 0 && !bool(view) && !chord && selected == g;
    if (preview && guide == 2) return;
    bool armed = preview && guide == 1;
    if (armed && !hasSource(g)) { glyph(0xffff9118, x - 1, y - 1, 332096); return; }
    int c = armed ? 0xffff0000 : colour(g);
    bool populated = bool((facts(g) & 4194304));
    bool mute = bool(((muted ^ batch) & (1 << g)));
    int reference = populated && getHeapInt(264 + g * 12) > 0 ? g : 8;
    int span = getHeapInt(264 + reference * 12);
    float position = bool(span) ? clockPosition(reference) * 2048.0 / float(span) : 0.0;
    for (int n = 0; n < 8; ++n)
    {
        float amount = clamp(0.0, one, position - float(n));
        float brightness = (armed || populated ? .10 : .01) + (armed ? .90 : populated ? .55 : .05) * amount;
        if (!armed && populated && mute) brightness *= .3;
        int point = (0x489a6210 >> (n * 4)) & 15;
        fillPixel(dim(c, brightness), x + (point & 3), y + (point >> 2));
    }
    if (armed) fillPixel(0xffff0000, x + 1, y + 1);
    else if (populated)
    {
        int center = mute ? ((561000 - 306 * abs(getMillisecondCounter() % 2000 - 1000)) / 10000) * 65793 : dim(c, .7);
        fillPixel(center, x + 1, y + 1);
    }
    else if (!mute) fillPixel(dim(c, .06), x + 1, y + 1);
}

void drawMetronome()
{
            if (!bool((meter & 16384))) { fillPixel(0xff202020, 7, 14); return; }
            float beat = metroPosition * float((meter >> 7) & 127) / 4.0 + float(parity);
            beat -= float(int(beat / 2.0)) * 2.0;
            float point = (one - abs(beat - one)) * 14.0;
            int x = int(point); float fraction = point - float(x);
            fillPixel(dim(allBits, (one - fraction) * .75), x, 14);
            if (x < 14) fillPixel(dim(allBits, fraction * .75), x + 1, 14);
        }

void drawScene()
{
 int now = getMillisecondCounter();
    if (resync && now - resyncAt >= 1000)
        { resync = 0; resyncAt = now; sendCC(15, 110, 19); }
    updateHold();
    if (now - sentAt >= 40) flushParameters();
    {
        metroPosition = clockPosition(8);
        if (!bool((meter & 16384))) pulseReady = 0;
        else {
            float span = float(getHeapInt(360)) / 256.0;
            if (!pulseReady) { pulseReady = 1; lastPosition = metroPosition; parity = 0; }
            else {
                float difference = metroPosition - lastPosition;
                if (difference < -span * .5)
                    { pulseAt = now; parity = parity ^ (meter & 1); lastPosition = metroPosition; }
                else if (difference > 0.0 && difference <= span * .5) lastPosition = metroPosition;

            }
    }} clearDisplay();
    if (!bool(view))
    {
        for (int g = 0; g < 12; ++g)
        {
            drawGroup(g);
            int owner = guide == 3 ? selected : monitor >= 0 ? monitor & 7 : ((meter >> 24) & 15) - 1;
            int dot = bool((batch & (1 << g))) ? 0xffb0b0b0 : owner == g ? 0xff2080ff : 0;
            if (bool(dot)) fillPixel(dot, g % 4 * 4 + 1, g / 4 * 4 + 3 - g / 8);
        }
        {
            if (anchor >= 0 && !chord && guide > 0 && guide < 3 && (guide == 2 || hasSource(selected))) {
                int x = (coordinate(anchor, 0) >> 7), y = (coordinate(anchor, 1) >> 7);
                int ex = guideX >> 7, ey = min(13, guideY >> 7);
                fillRect(allBits, x, y, 1, max(0, ey - y + 1));
                if (guide == 2) fillRect(allBits, min(x, ex), ey, abs(ex - x) + 1, 1);

            }
        }
        drawMetronome();
    }
    else if (view == 1)
    {
        if (selected >= 8) drawMetronome();
        int row = selected / 4, c = colour(selected), py = !bool(row) ? 4 : row == 1 ? 0 : 12;
        int height = 3 - row / 2;
        for (int n = 0; n < 4; ++n) drawGroup(row * 4 + n);
        fillRect(dim(c, .08), 0, py, 15, height); fillRect(dim(c, .18), 0, py + 1, 15, 1);
        fillPixel(0xff404040, 7, py + 1);
        fillRect(dim(c, .65), ((getHeapByte(parameterBase + 1) & 127) * 14 + 63) / 127, py, 1, height);
        drawFader(0, 3, c, float(getHeapByte(parameterBase) & 127) / 127.0);
        for (int n = 1; n < 5; ++n) drawFader(n * 3 + 1, 2, allBits, float(getHeapByte(parameterBase + n + 1) & 127) / 127.0);
    }
    else {
        float brightness = recPhase == 3 ? .5 : .10;
        int ac = dim(0xff60ff80, brightness), nc = dim(0xff60c0ff, brightness);
        recordingButton(0xff240808, 0xffff6060, 1, 1, 0x498c9);
        recordingButton(dim(ac, .15), ac, 8, 1, 0x11510);
        recordingButton(0xff241700, 0xffffb040, 1, 8, 0x725e2);
        recordingButton(dim(nc, .15), nc, 8, 8, 0x8e28a8);
        if (recPhase < 2 || !recBar) { markerKey = allBits; return; }
        float measure = float(recMeasure);
        float age = (meter & 16384) ? float(now - recAt) * float(tempo) / 30000.0 : 0.0;
        bool queued = recPhase == 2;
        measure = max(0.0, measure + (queued ? -age : age));
        float count = measure / (float(recBar) * 16.0);
        int completed = clamp(0, 111, int(count) - int(queued && count == float(int(count))));
        bool pages = queued && completed >= 8;
        float phase = pages ? count / 8.0 : count;
        phase -= float(int(phase));
        if (queued && measure > 0.0 && phase == 0.0) phase = one;
        int c = queued ? 0xffff0000 : colour(recGroup);
        if (flashGroup == recGroup && now - flashAt < 250) c = 0xffff9118;
        for (int n = 0; n < 56; ++n) markerPixel(n, dim(c, .08 + .57 * clamp(0.0, one, phase * 56.0 - float(n))));
        if (!queued || measure > 0.0)
        {
            drawMarkers(pages ? 8 : completed % 8 + 1, token * 16 + recGroup * 2 + int(!queued));
            for (int block = completed / 8; bool(block); --block) fillPixel(0xffb0b0b0, 7, 14 - block);
        }
        int elapsed = now - pulseAt;
        if ((meter & 16384) && elapsed >= 0 && elapsed < 160)
        {
            int white = ~((elapsed * 255 / 160) << 24);
            blendRect(white, 0, 0, 15, 1); blendRect(white, 0, 14, 15, 1);
            blendRect(white, 0, 1, 1, 13); blendRect(white, 14, 1, 1, 13);
        }
    }
}

// The first blocked frame precedes the grant by a complete repaint callback.
// Original contacts finish before locking; later orphaned moves/ends own no role.
void repaint()
{
    drawScene();
    if (bool(preparation) && !bool(down))
    {
        if (preparationPhase == 1) { flushParameters(); sendIntent(58, preparation); }
        if (preparationPhase < 2) ++preparationPhase;
        fillRect(0xffffc000, 4, 7, 7, 1);
    }
}
