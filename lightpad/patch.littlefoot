// Input patch selector, protocol19/A9. Host owns routing and gesture effects.
// Groups0..31, sources32..206, assignments208..239, name240..335,
// atomic RX336..359, contactXY360..423, seq424..439, tile440..455,
// pending456..471. Source/name records never mutate Live locally.
#heapsize: 472
int sentAt[16];
int downFingers;
int blockedFingers;
int sourceCount;
int sourceSeen;
int groupSeen;
int assignmentSeen;
int uiAt;
int helloAt;
int rxKind;
int rxRevision;
int rxPart;
int rxGroup;
int contextGroup;
int nameSource;
int nameOwner;
int nameLength;
int nameAt;
int flashSource;
int flashGroup;
bool metaSeen;
bool nameComplete;
bool linked;
bool announced;

int dim(int colour, float amount)
{ return blendARGB(0xff000000, (int(amount * 255.0) << 24) | (colour & 0xffffff)); }
int sourceByte(int index, int field) { return getHeapByte(32 + index * 7 + field); }
int groupColour(int group)
{ return makeARGB(255, getHeapByte(group * 4 + 1) << 1, getHeapByte(group * 4 + 2) << 1, getHeapByte(group * 4 + 3) << 1); }
int sourceColour(int source)
{ return makeARGB(255, sourceByte(source, 0) << 1, sourceByte(source, 1) << 1, sourceByte(source, 2) << 1); }
int assignment(int group)
{
    int base = 208 + group * 4;
    return getHeapByte(base) | (getHeapByte(base + 1) << 7)
        | (getHeapByte(base + 2) << 14) | (getHeapByte(base + 3) << 21);
}
int touchX(int finger) { return getHeapBits(2880 + finger * 32, 16); }
int touchY(int finger) { return getHeapBits(2896 + finger * 32, 16); }

void resetModel()
{
    sourceSeen = 0; groupSeen = 0; assignmentSeen = 0;
    metaSeen = false; sourceCount = 0; uiAt = 0;
    contextGroup = 127; nameSource = 127; nameOwner = 127;
    nameComplete = false; nameLength = 0;
    flashSource = 127; flashGroup = 127;
    rxKind = 0; announced = false;
    blockedFingers = downFingers;
    for (int finger = 0; finger < 16; ++finger)
    {
        setHeapByte(440 + finger, 127);
        setHeapByte(456 + finger, 0);
    }
}
void initialise()
{
    for (int offset = 0; offset < 472; ++offset) setHeapByte(offset, 0);
    downFingers = 0; resetModel(); linked = false;
    helloAt = getMillisecondCounter(); sendCC(15, 110, 19);
}

int tileAt(int x, int y)
{
    if (y < 4) return x % 4 < 3 ? (y / 2) * 4 + x / 4 : 127;
    if (y < 5) return 127;
    int input = ((y - 5) / 2) * 5 + x / 3;
    return input < sourceCount ? 8 + input : 127;
}

int heldGroup()
{
    int selected = 127;
    for (int finger = 0; finger < 16; ++finger)
    {
        if ((downFingers & (1 << finger)) == 0) continue;
        int tile = getHeapByte(440 + finger);
        if (tile >= 8) continue;
        if (selected != 127) return 126;
        selected = tile;
    }
    return selected;
}
bool heldTile(int tile)
{
    for (int finger = 0; finger < 16; ++finger)
        if ((downFingers & (1 << finger)) != 0 && getHeapByte(440 + finger) == tile) return true;
    return false;
}

void sendTouch(int finger, int kind)
{
    int sequence = getHeapByte(424 + finger);
    int x = touchX(finger), y = touchY(finger);
    int context = heldGroup();
    if (context >= 8) context = 0;
    sendCC(finger, 20, sequence);
    sendCC(finger, 21, kind | 24);
    sendCC(finger, 22, x & 127);
    sendCC(finger, 23, (x >> 7) | 48);
    sendCC(finger, 24, y & 127);
    sendCC(finger, 25, (y >> 7) | (context << 4));
    sendCC(finger, 26, sequence);
    setHeapByte(424 + finger, (sequence + 1) & 127);
    setHeapByte(456 + finger, 0);
    sentAt[finger] = getMillisecondCounter();
}
void rememberTouch(int finger, float x, float y)
{
    int px = int(clamp(0.0, 1919.0, x * 960.0));
    int py = int(clamp(0.0, 1919.0, y * 960.0));
    setHeapInt(360 + finger * 4, px | (py << 16));
}
void touchEvent(int kind, int finger, float x, float y)
{
    if (finger < 0 || finger > 15) return;
    int bit = 1 << finger;
    bool held = (downFingers & bit) != 0;
    if (kind == 1)
    {
        if (held) return;
        downFingers = downFingers | bit;
    }
    else if (!held) return;
    if (!announced || !linked || uiAt == 0 || getMillisecondCounter() - uiAt >= 3000)
        blockedFingers = blockedFingers | bit;
    if ((blockedFingers & bit) != 0)
    {
        if (kind == 3)
        {
            downFingers = downFingers & ~bit;
            blockedFingers = blockedFingers & ~bit;
        }
        return;
    }
    rememberTouch(finger, x, y);
    if (kind == 1)
        setHeapByte(440 + finger, tileAt(touchX(finger) / 128, touchY(finger) / 128));
    if (kind == 3)
    {
        downFingers = downFingers & ~bit;
        setHeapByte(440 + finger, 127);
    }
    if (kind == 2) setHeapByte(456 + finger, 1);
    if (kind != 2 || getMillisecondCounter() - sentAt[finger] >= 40) sendTouch(finger, kind);
}
void touchStart(int i, float x, float y, float z, float vz) { touchEvent(1, i, x, y); }
void touchMove(int i, float x, float y, float z, float vz) { touchEvent(2, i, x, y); }
void touchEnd(int i, float x, float y, float z, float vz) { touchEvent(3, i, x, y); }

bool zeroPadding(int begin)
{
    for (int n = begin; n < 18; ++n) if (getHeapByte(336 + n) != 0) return false;
    return true;
}
bool validSource(int source) { return source >= 0 && source < sourceCount; }
bool validOptionalSource(int source) { return source == 127 || validSource(source); }
bool validOptionalGroup(int group) { return group < 8 || group == 127; }

void acceptPatch()
{
    int type = getHeapByte(336);
    int index = getHeapByte(337);
    if (type == 0)
    {
        if (index > 25 || !zeroPadding(2)) return;
        if (!metaSeen || sourceCount != index)
        {
            sourceSeen = 0; assignmentSeen = 0;
            nameOwner = 127; nameLength = 0; nameComplete = false;
        }
        sourceCount = index; metaSeen = true;
    }
    else if (type == 1)
    {
        if (!validSource(index) || getHeapByte(341) > 1 || getHeapByte(343) > 1
            || getHeapByte(344) > 1 || !zeroPadding(9)) return;
        for (int field = 0; field < 7; ++field)
            setHeapByte(32 + index * 7 + field, getHeapByte(338 + field));
        sourceSeen = sourceSeen | (1 << index);
    }
    else if (type == 2)
    {
        if (!metaSeen || index > 7 || getHeapByte(341) > 15 || !zeroPadding(6)) return;
        int mask = getHeapByte(338) | (getHeapByte(339) << 7)
            | (getHeapByte(340) << 14) | (getHeapByte(341) << 21);
        if ((mask & ~((1 << sourceCount) - 1)) != 0) return;
        for (int n = 0; n < 4; ++n) setHeapByte(208 + index * 4 + n, getHeapByte(338 + n));
        assignmentSeen = assignmentSeen | (1 << index);
    }
    else if (type == 3)
    {
        int offset = getHeapByte(338);
        if (!validSource(index) || offset > 95 || (nameSource != 127 && index != nameSource)) return;
        bool terminated = false;
        for (int n = 0; n < 15; ++n)
        {
            int column = getHeapByte(339 + n);
            if (column > 16 || (terminated && column != 16)) return;
            if (column == 16) terminated = true;
            else if (offset + n >= 96) return;
        }
        if (offset == 0 && nameOwner == index)
        {
            // Repeated name heartbeats must not keep its local scroll at zero.
            bool same = true;
            for (int n = 0; n < 15; ++n)
            {
                int column = getHeapByte(339 + n);
                if (column == 16)
                {
                    if (!nameComplete || nameLength != n) same = false;
                    break;
                }
                if (n >= nameLength || getHeapByte(240 + n) != column) same = false;
            }
            if (same) return;
        }
        if (offset == 0)
        {
            nameOwner = index; nameComplete = false; nameLength = 0;
            nameAt = getMillisecondCounter();
        }
        else if (nameOwner != index || offset > nameLength) return;
        for (int n = 0; n < 15; ++n)
        {
            int column = getHeapByte(339 + n);
            if (column == 16) { nameLength = offset + n; nameComplete = true; return; }
            if (offset + n >= nameLength || getHeapByte(240 + offset + n) != column)
            { nameAt = getMillisecondCounter(); nameComplete = false; }
            setHeapByte(240 + offset + n, column);
            nameLength = max(nameLength, offset + n + 1);
        }
    }
    else if (type == 4)
    {
        int named = getHeapByte(338);
        int flashed = getHeapByte(339);
        int flashedGroup = getHeapByte(340);
        if (!metaSeen || !validOptionalGroup(index) || !validOptionalSource(named)
            || !validOptionalSource(flashed) || !validOptionalGroup(flashedGroup) || !zeroPadding(5)) return;
        contextGroup = index; nameSource = named;
        flashSource = flashed; flashGroup = flashedGroup;
        uiAt = getMillisecondCounter();
    }
}

void acceptGroup(int group)
{
    if (getHeapByte(336) > 2 || (getHeapByte(337) != 0 && getHeapByte(337) != 127)
        || getHeapByte(347) > 31 || getHeapByte(348) > 4) return;
    setHeapByte(group * 4, getHeapByte(336));
    for (int n = 0; n < 3; ++n) setHeapByte(group * 4 + n + 1, getHeapByte(339 + n));
    groupSeen = groupSeen | (1 << group);
}

void handleMessage(int m0, int m1, int header)
{
    int previous = rxKind; rxKind = 0;
    if ((header & 255) != 169 || (header & 0xff000000) != 0
        || ((m0 | m1) & 0x80808080) != 0) return;
    int kind = (header >> 8) & 7;
    int group = (header >> 11) & 15;
    int part = (header >> 15) & 3;
    int revision = (header >> 17) & 127;
    if (kind == 3)
    {
        if (group != 12 || part != 0 || revision != 0 || m0 != 274 || m1 != 0) return;
        resetModel(); linked = true; return;
    }
    if (!linked || (kind != 0 && kind != 4) || (kind == 0 && group > 7) || (kind == 4 && group != 12)) return;
    int length = kind == 0 ? 15 : 18;
    int last = (length - 1) / 8;
    if (part > last) return;
    int count = part == last ? length - part * 8 : 8;
    if (count < 4) { if ((m0 >> (count * 8)) != 0 || m1 != 0) return; }
    else if (count < 8) { if ((m1 >> ((count - 4) * 8)) != 0) return; }
    if (part == 0) { rxKind = kind + 1; rxGroup = group; rxRevision = revision; }
    else if (previous != kind + 1 || group != rxGroup || revision != rxRevision || part != rxPart) return;
    setHeapInt(336 + part * 8, m0); setHeapInt(340 + part * 8, m1);
    if (part < last) { rxKind = kind + 1; rxPart = part + 1; return; }
    rxKind = 0;
    if (kind == 0) acceptGroup(group); else acceptPatch();
}

void updateModel()
{
    int now = getMillisecondCounter();
    if (uiAt != 0 && now - uiAt >= 3000) { resetModel(); linked = false; }
    if (!linked && now - helloAt >= 1000)
    { sendCC(15, 110, 19); helloAt = now; }
    if (linked && !announced && metaSeen && groupSeen == 255 && assignmentSeen == 255
        && sourceSeen == (1 << sourceCount) - 1 && uiAt != 0)
    { announced = true; sendCC(15, 108, 37); }
    for (int finger = 0; finger < 16; ++finger)
    {
        if ((downFingers & ~blockedFingers & (1 << finger)) != 0 && announced
            && now - sentAt[finger] >= (getHeapByte(456 + finger) != 0 ? 40 : 250)) sendTouch(finger, 2);
    }
}

void drawName()
{
    if (!nameComplete || nameSource != nameOwner || nameLength == 0) return;
    int start = nameLength <= 15 ? -(15 - nameLength) / 2
        : ((getMillisecondCounter() - nameAt) / 160) % (nameLength + 8);
    for (int x = 0; x < 15; ++x)
    {
        int column = start + x;
        if (column >= nameLength) column -= nameLength + 8;
        if (column < 0 || column >= nameLength) continue;
        int bits = getHeapByte(240 + column);
        for (int y = 0; y < 4; ++y)
            if ((bits & (1 << y)) != 0) fillPixel(0xffb0b0b0, x, y);
    }
}

void repaint()
{
    updateModel(); fillRect(0xff000000, 0, 0, 15, 15);
    if (!announced || uiAt == 0) return;
    int group = heldGroup();
    bool label = group == 127 && nameSource != 127 && heldTile(8 + nameSource);
    for (int g = 0; g < 8; ++g)
    {
        if (getHeapByte(g * 4) == 0) continue;
        int c = groupColour(g);
        float bright = label ? 0.03 : group == g ? 0.65 : 0.12;
        if (heldTile(g)) bright = 0.65;
        if (flashGroup == g) c = 0xffff2020;
        fillRect(dim(c, flashGroup == g ? 0.8 : bright), (g % 4) * 4, (g / 4) * 2, 3, 2);
    }
    for (int source = 0; source < sourceCount; ++source)
    {
        int c = sourceColour(source);
        int owners = sourceByte(source, 4) | (sourceByte(source, 5) << 7);
        bool assigned = group < 8 && (assignment(group) & (1 << source)) != 0;
        float bright = assigned ? 0.65 : owners != 0 ? 0.015 : sourceByte(source, 6) != 0 ? 0.12 : 0.025;
        if (heldTile(8 + source)) bright = 0.8;
        if (flashSource == source) { c = 0xffff2020; bright = 0.8; }
        fillRect(dim(c, bright), (source % 5) * 3, 5 + (source / 5) * 2, 3, 2);
    }
    if (label) drawName();
}
