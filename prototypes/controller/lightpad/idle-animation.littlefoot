// Accepted v9 idle behavior, extracted with callback names scoped for status.
// Origin: codex/idle-animation-discovery at bb90f24. Logic is unchanged.
// THROWAWAY idle discovery v9: corner entry, free movement along the outer edge.
// Native curved primitives give depth without expensive per-pixel iteration.
// One finger bends the tunnel; pressure moves into it. Two fingers pull its ends.
// Three fingers change the space. Four reset. No MIDI or Live interaction.
#include "idle-statements-prototype.littlefoot"
float fingerX[16];
float fingerY[16];
float fingerZ[16];
int fingers;
int family;
int lastFrame;
int nextReport;
int anchorA;
int anchorB;
int joinedA;
int joinedB;
int familyAt;
int leftA;
int leftB;
float travel;
float farX;
float farY;
float nearX;
float nearY;
float pressure;
float twist;
float splitMix;
float corridorMix;
float entryAX;
float entryAY;
float entryBX;
float entryBY;
float entryPressure;
float entryTwist;
float familyFromSplit;
float familyFromCorridor;
float exitAX;
float exitAY;
float exitBX;
float exitBY;
float exitPressure;
float exitTwist;
bool statementMode;
bool statementPreview;
bool statementHoldConsumed;
bool statementTap;
int statementScreen;
int statementHoldAt;
int statementTapAt;
int statementTapFinger;
float statementTapX;
float statementTapY;

int touchCorner(int finger)
{
    float x = fingerX[finger];
    float y = fingerY[finger];
    if (x < 3.0 && y < 3.0) return 0;
    if (x > 11.0 && y < 3.0) return 1;
    if (x > 11.0 && y > 11.0) return 2;
    if (x < 3.0 && y > 11.0) return 3;
    return -1;
}

bool touchOnEdge(int finger)
{
    return fingerX[finger] < 3.0 || fingerX[finger] > 11.0
        || fingerY[finger] < 3.0 || fingerY[finger] > 11.0;
}

void releaseIdleInfluence(int now)
{
    exitAX = farX; exitAY = farY; exitPressure = pressure;
    exitBX = nearX; exitBY = nearY; exitTwist = twist;
    leftA = now; leftB = now; anchorA = -1; anchorB = -1;
}

void checkStatementHold(int now)
{
    int a = firstFinger(0);
    int b = a >= 0 ? firstFinger(a + 1) : -1;
    bool opposite = false;
    if (a >= 0 && b >= 0 && firstFinger(b + 1) < 0)
    {
        if (statementPreview) opposite = touchOnEdge(a) && touchOnEdge(b);
        else
        {
            int ca = touchCorner(a);
            int cb = touchCorner(b);
            opposite = ca >= 0 && cb >= 0 && abs(ca - cb) == 2;
        }
    }
    if (statementHoldConsumed) return;
    if (!opposite)
    {
        if (statementPreview)
        {
            statementPreview = false; statementHoldConsumed = true;
            statementHoldAt = 0; statementTap = false;
            releaseIdleInfluence(now);
            log(9892);
        }
        return;
    }
    if (!statementPreview)
    {
        statementPreview = true; statementHoldAt = now; statementTap = false;
        releaseIdleInfluence(now);
        log(statementMode ? 9890 : 9891);
    }
    if (now - statementHoldAt >= 2000)
    {
        statementMode = !statementMode;
        statementPreview = false;
        statementHoldConsumed = true; statementTap = false;
        statementHoldAt = 0;
        releaseIdleInfluence(now);
        log(statementMode ? 9871 : 9870);
    }
}

float joined(int age)
{
    float t = clamp(0.0, 1.0, float(age) / 2000.0);
    return t * t * (3.0 - 2.0 * t);
}

float wave(float phase)
{
    phase -= float(int(phase));
    if (phase < 0.0) phase += 1.0;
    float p = phase * 2.0;
    bool negative = p >= 1.0;
    if (negative) p -= 1.0;
    float value = 4.0 * p * (1.0 - p);
    return negative ? -value : value;
}

int tint(float hue, int alpha, int brightness)
{
    hue -= float(int(hue));
    if (hue < 0.0) hue += 1.0;
    float h = hue * 6.0;
    int sector = int(h);
    int up = int((h - float(sector)) * float(brightness));
    int down = brightness - up;
    if (sector == 0) return makeARGB(alpha, brightness, up, 12);
    if (sector == 1) return makeARGB(alpha, down, brightness, 12);
    if (sector == 2) return makeARGB(alpha, 12, brightness, up);
    if (sector == 3) return makeARGB(alpha, 12, down, brightness);
    if (sector == 4) return makeARGB(alpha, up, 12, brightness);
    return makeARGB(alpha, brightness, 12, down);
}

int firstFinger(int start)
{
    for (int n = start; n < 16; ++n) if ((fingers & (1 << n)) != 0) return n;
    return -1;
}

int touchCount()
{
    int result = 0;
    for (int n = 0; n < 16; ++n) if ((fingers & (1 << n)) != 0) ++result;
    return result;
}

void initialiseIdle()
{
    fingers = 0; family = 0; travel = 0.0;
    farX = 7.0; farY = 7.0; nearX = 7.0; nearY = 7.0;
    pressure = 0.0; twist = 1.0; splitMix = 0.0; corridorMix = 0.0;
    anchorA = -1; anchorB = -1;
    familyFromSplit = 0.0; familyFromCorridor = 0.0;
    lastFrame = getMillisecondCounter();
    leftA = lastFrame - 2000; leftB = lastFrame - 2000;
    statementMode = false; statementPreview = false;
    statementHoldConsumed = false; statementTap = false;
    statementScreen = 0; statementHoldAt = 0;
    clearDisplay();
    log(10000);
}

void idleTouchMove(int index, float x, float y, float z, float vz)
{
    if (index < 0 || index > 15) return;
    fingerX[index] = clamp(0.0, 14.0, x * 7.5);
    fingerY[index] = clamp(0.0, 14.0, y * 7.5);
    fingerZ[index] = clamp(0.0, 1.0, z);
    if (statementTap && index == statementTapFinger
        && (abs(fingerX[index] - statementTapX) > 1.5 || abs(fingerY[index] - statementTapY) > 1.5))
        statementTap = false;
    checkStatementHold(getMillisecondCounter());
}

void idleTouchStart(int index, float x, float y, float z, float vz)
{
    if (index < 0 || index > 15) return;
    if ((fingers & (1 << index)) != 0)
    {
        idleTouchMove(index, x, y, z, vz);
        return;
    }
    fingers = fingers | (1 << index);
    idleTouchMove(index, x, y, z, vz);
    int now = getMillisecondCounter();
    if (statementMode || statementPreview || statementHoldConsumed)
    {
        if (statementMode && !statementPreview && !statementHoldConsumed && touchCount() == 1)
        {
            statementTap = true; statementTapAt = now; statementTapFinger = index;
            statementTapX = fingerX[index]; statementTapY = fingerY[index];
        }
        else statementTap = false;
        return;
    }
    // Roles follow arrival order, not the sensor's reusable finger IDs.
    if (anchorA < 0)
    {
        anchorA = index; joinedA = now;
        entryAX = farX; entryAY = farY; entryPressure = pressure;
    }
    else if (anchorB < 0 && anchorA != index)
    {
        anchorB = index; joinedB = now;
        entryBX = nearX; entryBY = nearY; entryTwist = twist;
    }
    int count = touchCount();
    if (count == 3 || count == 4)
    {
        familyFromSplit = splitMix; familyFromCorridor = corridorMix;
        familyAt = now;
        family = count == 4 ? 0 : (family + 1) % 3;
        log(10000 + family);
    }
}

void idleTouchEnd(int index, float x, float y, float z, float vz)
{
    if (index < 0 || index > 15) return;
    idleTouchMove(index, x, y, z, vz);
    bool handled = statementMode || statementPreview || statementHoldConsumed;
    fingers = fingers & ~(1 << index);
    if (statementPreview)
    {
        statementPreview = false; statementHoldConsumed = true; statementTap = false;
        releaseIdleInfluence(getMillisecondCounter());
        log(9892);
    }
    statementHoldAt = 0;
    if (handled)
    {
        if (statementMode && !statementHoldConsumed && statementTap && index == statementTapFinger
            && fingers == 0 && getMillisecondCounter() - statementTapAt < 450
            && abs(x * 7.5 - statementTapX) <= 1.5 && abs(y * 7.5 - statementTapY) <= 1.5)
        {
            statementScreen = (statementScreen + 1) % 4;
            log(9880 + statementScreen);
        }
        statementTap = false;
        if (fingers == 0) statementHoldConsumed = false;
        return;
    }
    if (anchorA == index)
    {
        exitAX = farX; exitAY = farY; exitPressure = pressure;
        leftA = getMillisecondCounter(); anchorA = -1;
    }
    if (anchorB == index)
    {
        exitBX = nearX; exitBY = nearY; exitTwist = twist;
        leftB = getMillisecondCounter(); anchorB = -1;
    }
}

void repaintIdle()
{
    int now = getMillisecondCounter();
    int elapsed = clamp(0, 80, now - lastFrame);
    lastFrame = now;
    checkStatementHold(now);
    if (statementMode != statementPreview) { drawIdleStatement(statementScreen); return; }
    int a = anchorA;
    int b = anchorB;
    float dt = float(elapsed);
    float gainA = a >= 0 ? joined(now - joinedA) : 0.0;
    float gainB = b >= 0 ? joined(now - joinedB) : 0.0;
    float leavingA = a < 0 ? 1.0 - joined(now - leftA) : 0.0;
    float leavingB = b < 0 ? 1.0 - joined(now - leftB) : 0.0;
    float positionEase = dt / (dt + (a >= 0 || leavingA > 0.0 ? 8.0 : 140.0));
    float nearEase = dt / (dt + (b >= 0 || leavingB > 0.0 ? 8.0 : 140.0));
    float pressureEase = dt / (dt + 20.0);
    float idleX = 7.0 + wave(float(now % 22222) / 22222.0) * 2.2;
    float idleY = 7.0 + wave(float(now % 27027) / 27027.0 + 0.25) * 2.2;
    float targetFarX = a >= 0 ? entryAX + (fingerX[a] - entryAX) * gainA
                             : idleX + (exitAX - idleX) * leavingA;
    float targetFarY = a >= 0 ? entryAY + (fingerY[a] - entryAY) * gainA
                             : idleY + (exitAY - idleY) * leavingA;
    float baseNearX = 14.0 - targetFarX;
    float baseNearY = 14.0 - targetFarY;
    float targetNearX = b >= 0 ? entryBX + (fingerX[b] - entryBX) * gainB
                              : baseNearX + (exitBX - baseNearX) * leavingB;
    float targetNearY = b >= 0 ? entryBY + (fingerY[b] - entryBY) * gainB
                              : baseNearY + (exitBY - baseNearY) * leavingB;
    farX += (targetFarX - farX) * positionEase;
    farY += (targetFarY - farY) * positionEase;
    nearX += (targetNearX - nearX) * nearEase;
    nearY += (targetNearY - nearY) * nearEase;
    float targetPressure = a >= 0 ? entryPressure + (fingerZ[a] - entryPressure) * gainA : exitPressure * leavingA;
    pressure += (targetPressure - pressure) * pressureEase;
    float baseTwist = 1.0 + pressure * 3.0;
    float targetTwist = b >= 0 ? entryTwist + ((fingerX[b] - farX) * 0.22 - entryTwist) * gainB
                              : baseTwist + (exitTwist - baseTwist) * leavingB;
    twist += (targetTwist - twist) * dt / (dt + 20.0);
    float morph = joined(now - familyAt);
    splitMix = familyFromSplit + ((family == 1 ? 1.0 : 0.0) - familyFromSplit) * morph;
    corridorMix = familyFromCorridor + ((family == 2 ? 1.0 : 0.0) - familyFromCorridor) * morph;
    travel += float(elapsed) * (0.00065 + pressure * 0.0018);
    travel -= float(int(travel));
    float hue = float(now % 18000) / 18000.0;
    clearDisplay(0xff010107);

    for (int layer = 0; layer < 8; ++layer)
    {
        float d = (float(layer) + travel) / 7.0;
        float r = 0.30 + d * d * (13.5 + pressure * 3.0);
        float angle = float(now % 18182) / 18182.0 + d * (0.24 + pressure * 0.22);
        float cx = farX * (1.0 - d) + nearX * d + wave(angle) * twist * d;
        float cy = farY * (1.0 - d) + nearY * d + wave(angle + 0.25) * twist * d;
        int alpha = int(clamp(0.0, 1.0, 1.18 - d) * 220.0);
        int colour = tint(hue + d * 0.23, alpha, int(90.0 + min(1.0, d) * 150.0));
        float separation = splitMix * wave(angle) * (1.0 + d * 3.0) - corridorMix * r * 0.7;
        float radius = r * (1.0 - splitMix * 0.28);
        float branching = clamp(0.0, 1.0, splitMix + corridorMix);
        blendCircle(colour, cx + separation, cy, radius, false);
        blendCircle(tint(hue + d * 0.23 + splitMix * 0.45 + corridorMix * 0.2,
                        int(float(alpha) * (0.2 + branching * 0.8)), int(180.0 + branching * 20.0)),
                    cx - separation, cy, radius + (1.0 - branching) * 0.65, false);
    }
    if (now > nextReport)
    {
        log(1000000 + min(99, getTimeInCurrentFunctionCall()) * 100 + family);
        nextReport = now + 2000;
    }
}
