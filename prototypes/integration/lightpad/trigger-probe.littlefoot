#heapsize: 256
// Same visible one-square feedback probe, with an automation-only CC22 trigger.
// Channel 16 CC22=0/127 requests that value through the normal pad CC20 path.
// Live is the sole CC20 feedback writer; the pad echoes received feedback on CC21.
// Keep CC21 and CC22 unmapped. Upload temporarily; preserve the stored default.
// Logs: 6000 initialise, 6100+value feedback, 6200+value request, 6300 timeout.

int confirmedState;
int awaitingReply;
int requestedAt;
int capturedTouch;

void initialise()
{
    confirmedState = -1;
    awaitingReply = 0;
    capturedTouch = -1;
    log(6000);
}

void handleMIDI(int status, int controller, int value)
{
    if (status == 0xbf && controller == 22
        && (value == 0 || value == 127)
        && awaitingReply == 0 && capturedTouch == -1)
    {
        awaitingReply = 1;
        requestedAt = getMillisecondCounter();
        log(6200 + value);
        sendCC(15, 20, value);
    }

    if (status == 0xbf && controller == 20 && value >= 0 && value <= 127)
    {
        confirmedState = value >= 64 ? 1 : 0;
        awaitingReply = 0;
        log(6100 + value);
        sendCC(15, 21, value);
    }
}

void touchStart(int index, float x, float y, float z, float vz)
{
    if (capturedTouch == -1 && awaitingReply == 0)
        capturedTouch = index;
}

void touchEnd(int index, float x, float y, float z, float vz)
{
    if (index != capturedTouch)
        return;

    capturedTouch = -1;
    if (awaitingReply != 0)
        return;

    int desiredValue = confirmedState == 1 ? 0 : 127;
    awaitingReply = 1;
    requestedAt = getMillisecondCounter();
    log(6200 + desiredValue);
    sendCC(15, 20, desiredValue);
}

void repaint()
{
    if (awaitingReply != 0 && getMillisecondCounter() - requestedAt >= 2000)
    {
        awaitingReply = 0;
        confirmedState = -1;
        log(6300);
    }

    int colour = confirmedState == -1 ? makeARGB(255, 160, 80, 0)
                 : confirmedState == 1 ? makeARGB(255, 0, 180, 0)
                 : makeARGB(255, 35, 0, 0);
    fillRect(awaitingReply != 0 ? makeARGB(255, 0, 70, 255) : colour,
             0, 0, 15, 15);
    fillRect(colour, 1, 1, 13, 13);
}
